# 测试环境配置示例
# 复制此文件为 .env.local 并填入真实值
# 命令：cp .env.example .env.local

# TMDB API Token（可选，用于测试）
# 在 https://www.themoviedb.org/settings/api 申请
TMDB_TOKEN=your_tmdb_token_here

# CORS 代理地址（用于视频采集站 API 请求）
CORS_PROXY=https://your-video-proxy.example.com

# IPTV 代理地址（用于 IPTV M3U 流代理）
IPTV_PROXY=https://your-iptv-proxy.example.com
