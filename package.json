{
  "name": "kinotv",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:fast": "tsc -b && cross-env VITE_COMPRESS=false vite build",
    "sync:capacitor-version": "node scripts/sync-capacitor-version.mjs",
    "build:android": "cross-env CAPACITOR=true tsc -b && vite build && node scripts/clean-compressed.js && node scripts/sync-capacitor-version.mjs && npx cap sync android",
    "icons:android": "npm install --no-save sharp && node scripts/generate-icons.mjs && npm uninstall sharp",
    "open:android": "npx cap open android",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint:fix": "eslint . --fix",
    "lint:all": "npm run lint:css && npm run lint && npm run build",
    "preview": "vite preview",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name video-warehouse",
    "deploy:worker": "cd worker && npx wrangler deploy",
    "deploy:cors": "cd worker && npx wrangler deploy -c wrangler-cors.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:changed": "pwsh scripts/run-tests.ps1",
    "test:smart": "pwsh scripts/run-tests.ps1 -AutoDetect",
    "test:smoke": "pwsh scripts/run-tests.ps1 -AutoDetect -Group smoke",
    "test:regression": "pwsh scripts/run-tests.ps1 -AutoDetect -Group regression",
    "test:e2e": "npx playwright test && node scripts/localize-report.mjs",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.13",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "dashjs": "^5.2.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "^1.6.16",
    "idb": "^8.0.2",
    "lucide-react": "^1.16.0",
    "mpegts.js": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "cssnano": "^8.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^3.4.17",
    "terser": "^5.48.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.9"
  }
}
