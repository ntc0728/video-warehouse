# Enforce LF line endings for all text files
# Prevents agent edits from causing CRLF↔LF flips (whole-file git diff)
* text=auto eol=lf

# Explicitly set for common source files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf

# Binary files — do not modify
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# 本地 HLS 测试流片段（MPEG-TS 二进制，勿当文本归一化，否则损坏）
scripts/fixtures/hls/stream/*.ts binary
scripts/fixtures/hls/stream/*.m3u8 text eol=lf
