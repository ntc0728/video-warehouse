# Cloudflare Pages 响应头
# 注意：规则从上到下「第一个匹配生效」。
# index.html 必须不缓存（每次重新验证）——否则浏览器/边缘缓存旧 index.html 引用的旧
# hash assets 已不存在 → 404 → _redirects 的 SPA fallback 返回 HTML → 模块加载
# "MIME type text/html" 报错。
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# assets 带内容 hash，可长期缓存（immutable）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 数据源 JSON：短缓存
/data/*
  Cache-Control: public, max-age=3600

# ── 安全响应头（OWASP Secure Headers；全站生效）──
# CSP 采用渐进式：非破坏性指令直接 enforce，完整策略先以 Report-Only 观察违规再逐步收紧
# （boot 启动脚本为内联、流媒体源为 http/https 混合，直接 enforce 会破坏功能）。
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https: http: blob:; connect-src 'self' https: http: blob:; font-src 'self' data:; worker-src 'self' blob:; frame-src 'none'
