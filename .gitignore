# ── 依赖 ──────────────────────────────────────
node_modules

# ── 构建产物 ──────────────────────────────────
dist
dist_verify
build
*.tsbuildinfo
vite.config.d.ts
vite.config.js

# ── 环境变量（含密钥，禁止提交）─────────────────
.env
.env.local
.env.*.local

# ── 日志 ──────────────────────────────────────
*.log
*.err
npm-debug.log*

# ── Cloudflare Worker ────────────────────────
.wrangler

# ── Capacitor / Android ──────────────────────
android/
*.apk

# ── AI 工具本地配置（不入版本控制）──────────────
.claude/
.codebuddy/
.reasonix/
.trae-cn/
.codex/
.mimocode/
.mimocode-project-id
.catpaw/
.opencode/
.codegraph/
.mignore
.workbuddy/
.codegraph/

# ── AI 工具本地规则 / 文档 ────────────────────
.trae/documents/
.trae/specs/
.trae/rules/

# ── 备份 ──────────────────────────────────────
backups/
*.bak
dist-bak-*/

# ── 脚本产物 ──────────────────────────────────
output/

# ── 测试数据 / 结果 ───────────────────────────
epg_test.xml
data/iptv.m3u
test-results/
test-storage-state.json
playwright-report/
.playwright-cli/
iptv-verify/

# ── 截图 ──────────────────────────────────────
shots/
ScreenShot_*.png
collections-b-*.png
timeline-*.png

# ── 构建和 lint 输出 ──────────────────────────
build-final.txt
lint-final.txt
lint-output.txt
lintcss-final.txt

# ── agent-browser 工具临时产物 ─────────────────
b64.tmp
agent-browser.json

# ── 调试工具（本地开发用）──────────────────────
public/db-inspector.html
public/debug-source.html

# ── 脚本截图目录 ──────────────────────────────
scripts/screenshots/

# ── 文档（仅提交 KNOWLEDGE.md / TEST-CASES.md / KNOWN-ISSUES.md / PRODUCTION-REVIEW）──
docs/*
!docs/KNOWLEDGE.md
!docs/TEST-CASES.md
!docs/KNOWN-ISSUES.md
!docs/PRODUCTION-REVIEW-*.md

# ── 研究文档（本地用，不入版本控制）────────────
research/
prototypes/

# ── 旧规则文件 ────────────────────────────────
rules.md

# ── 开发辅助脚本（非构建/测试脚本不入版本控制）──
# 保留：.ps1/.bat 构建脚本、.spec.ts E2E 测试、.md 文档
scripts/*.sh
scripts/*.py
scripts/*.js
scripts/*.ts
scripts/*.mjs
!scripts/*.spec.ts
!scripts/fetch-diagram-data.mjs
!scripts/sync-android-version.mjs
!scripts/global-setup.ts
# 测试 fixtures（mock 数据）纳入版本控制，保证 CI / 他人 clone 后
# 首页 8 区块等 mock 覆盖一致，箭头/骨架等测试可稳定断言
scripts/fixtures/*
!scripts/fixtures/*.ts
scripts/backup-specs/

# ── OS 临时文件 ───────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDE / 编辑器 ──────────────────────────────
.idea/
*.swp
*.swo
*~

# ── git 仓库损坏备份（重建后不应提交） ─────────
.git.broken-*/
